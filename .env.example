# URL of your Immich server, no trailing slash
IMMICH_URL=https://immich.example.com

# Immich API key (Account Settings -> API Keys). Needs at least the
# asset.read and asset.download permissions.
IMMICH_API_KEY=

# Any long random string. Must match the header value you configure on the
# Immich Workflow's "Trigger Webhook" action (see README).
WEBHOOK_SECRET=change-me-to-something-random

# How this app is reachable from your own browser (used to build the
# "View Splat" links on the status page). If you're running this on the
# same machine you'll view it from, localhost is fine.
PUBLIC_BASE_URL=http://localhost:8080

# Immich server URL as seen from the app container. The default assumes the
# Immich server container is named immich-server and this stack joins Immich's
# Docker network (IMMICH_NETWORK). Otherwise use the server's own URL,
# e.g. https://immich.example.com (no trailing slash).
IMMICH_URL=http://immich-server:2283

# Immich API key (Account Settings -> API Keys). Needs asset.download only.
# Add asset.view only if you want RAW / other formats (Immich's rendered preview is used).
IMMICH_API_KEY=

# Optional. The Immich address you open in your browser, e.g. https://photos.example.com
# (no trailing slash). Used for "Open in Immich" links in the gallery. Leave empty to hide them.
IMMICH_PUBLIC_URL=

# Long random string. Must match the X-Webhook-Secret header value in the
# Immich workflow's "Trigger Webhook" action (see README).
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=

# Docker network your Immich stack runs on (its default network is usually immich_default).
IMMICH_NETWORK=immich_default

# Host address the app port is published on. 127.0.0.1 = this machine only.
# 127.0.0.1 = only this machine can open the gallery.
# 0.0.0.0   = any device on your network can (the gallery has no login; don't
#             forward the port to the internet; use a reverse proxy with HTTPS for that).
APP_BIND=127.0.0.1

# Port on the host for the gallery. Change it if 8080 is already taken.
# (Inside Docker the app always listens on 8080, so the Immich webhook URL stays the same.)
APP_PORT=8080

# Keep the intermediate .ply file next to the .spz (true/false).
KEEP_PLY=false

# Worker device: default | cuda | cpu
SHARP_DEVICE=default
